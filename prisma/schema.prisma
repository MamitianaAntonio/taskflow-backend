generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserAccount {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String?
  password      String
  todos         Todo[]
  projects      Project[]
  notifications Notification[]
}

model Project {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  todos       Todo[]
}

enum TodoStatus {
  todo
  doing
  done
}

model Todo {
  id          Int         @id @default(autoincrement())
  title       String
  status      TodoStatus  @default(todo)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  dueDate     DateTime?
  priority    String      @default("medium")
  description String?
  user        UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId Int?
}

enum NotificationType {
  todo_created
  todo_updated
  todo_deleted
  todo_due_soon
  project_created
  project_updated
  project_deleted
}

model Notification {
  id            Int              @id @default(autoincrement())
  type          NotificationType
  message       String
  read          Boolean          @default(false)
  createdAt     DateTime         @default(now())
  todoId        Int?
  reminderStage String?
  user          UserAccount      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int

  @@index([todoId, reminderStage])
}
